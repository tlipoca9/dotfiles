#!/usr/bin/env python3
"""Merge the dotfiles-owned Pi settings while preserving Pi runtime state."""

from __future__ import annotations

import json
import sys


BROWSER_EXTENSION_SOURCE = {
    "repository": "https://github.com/amosblomqvist/pi-config.git",
    "commit": "f82da563ab05d66729492d64c7ed4e96db3663f3",
    "localPolicy": "default-on",
}


MANAGED_SETTINGS = {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-5.6-sol",
    "defaultThinkingLevel": "high",
    "enabledModels": ["openai-codex/*", "openai/gpt-*"],
    "subagents": {
        "defaultThinking": "low"
    },
    "theme": "dark",
    "enableInstallTelemetry": False,
    "observational-memory": {
        "model": {
            "provider": "openai-codex",
            "id": "gpt-5.6-terra",
            "thinking": "low",
        },
        "compactAfterTokensMode": "ratio",
        "compactAfterTokensRatio": 0.68,
    },
    "packages": [
        "npm:pi-open-tui@0.2.16",
        "npm:pi-lean-ctx@3.9.20",
        "npm:pi-web-access@0.25.0",
        # Async delegation with native child-to-parent clarification requests.
        "npm:pi-subagents@0.57.0",
        "npm:pi-mcp-adapter@2.29.0",
        "npm:pi-lens@4.1.2",
        "npm:pi-observational-memory@3.0.4",
        "npm:@narumitw/pi-goal@0.54.3",
        "npm:@plannotator/pi-extension@0.27.8",
        "npm:@ff-labs/pi-fff@0.10.5",
        "npm:@tmustier/pi-usage-extension@0.9.4",
    ],
}


def main() -> int:
    raw = sys.stdin.read()
    try:
        settings = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError as error:
        print(f"Pi settings are not valid JSON: {error}", file=sys.stderr)
        return 1
    if not isinstance(settings, dict):
        print("Pi settings must contain a JSON object", file=sys.stderr)
        return 1

    settings.update(MANAGED_SETTINGS)
    json.dump(settings, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
