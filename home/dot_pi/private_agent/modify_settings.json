#!/usr/bin/env python3
"""Merge the dotfiles-owned Pi settings while preserving Pi runtime state."""

from __future__ import annotations

import json
import sys


MANAGED_SETTINGS = {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-5.6-sol",
    "defaultThinkingLevel": "high",
    "enabledModels": ["openai-codex/*", "openai/gpt-*"],
    "subagents": {
        "defaultThinking": "low"
    },
    "theme": "dark",
    "enableInstallTelemetry": False,
    "observational-memory": {
        "model": {
            "provider": "openai-codex",
            "id": "gpt-5.6-terra",
            "thinking": "low",
        },
        "compactAfterTokensMode": "ratio",
        "compactAfterTokensRatio": 0.68,
    },
    "packages": [
        "npm:pi-open-tui@0.2.11",
        "npm:pi-rewind@0.5.0",
        "npm:pi-interactive-shell@0.14.1",
        "npm:pi-memctx@0.13.1",
        "npm:pi-lean-ctx@3.9.18",
        "npm:pi-web-access@0.20.0",
        "npm:pi-subagents@0.45.2",
        "npm:pi-mcp-adapter@2.21.2",
        "npm:pi-lens@3.8.74",
        "npm:pi-observational-memory@3.0.3",
        "npm:pi-extmgr@0.3.0",
        "npm:@narumitw/pi-goal@0.50.0",
        "npm:@plannotator/pi-extension@0.26.7",
        "npm:@ff-labs/pi-fff@0.10.3",
        "npm:@tmustier/pi-usage-extension@0.9.4",
        "npm:@narumitw/pi-chrome-devtools@0.50.1",
        "npm:@narumitw/pi-btw@0.49.7",
        "npm:@narumitw/pi-stamp@0.49.3",
        "npm:pi-simplify@0.2.3",
    ],
}


def main() -> int:
    raw = sys.stdin.read()
    try:
        settings = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError as error:
        print(f"Pi settings are not valid JSON: {error}", file=sys.stderr)
        return 1
    if not isinstance(settings, dict):
        print("Pi settings must contain a JSON object", file=sys.stderr)
        return 1

    settings.update(MANAGED_SETTINGS)
    json.dump(settings, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
