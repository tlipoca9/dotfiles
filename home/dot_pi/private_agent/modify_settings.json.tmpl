#!/usr/bin/env python3
"""Merge the dotfiles-owned Pi settings while preserving Pi runtime state."""

from __future__ import annotations

import json
import sys


MANAGED_SETTINGS = {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-5.6-sol",
    "defaultThinkingLevel": "high",
    "enabledModels": ["openai-codex/*", "openai/gpt-*"],
    "subagents": {
        "defaultThinking": "medium",
    },
    "tuiMode": "fullscreen",
    "quietStartup": True,
    "theme": "workspace",
    "hideThinkingBlock": False,
    "enableInstallTelemetry": False,
    "observational-memory": {
        "model": {
            "provider": "openai-codex",
            "id": "gpt-5.6-terra",
            "thinking": "low",
        },
        "compactAfterTokensMode": "ratio",
        "compactAfterTokensRatio": 0.68,
    },
    "packages": [
        # Async delegation with native child-to-parent clarification requests.
        "npm:pi-subagents@0.59.0",
        "npm:pi-btw@0.4.1",
        "npm:pi-mcp-adapter@2.31.0",
        "npm:pi-lens@4.1.3",
        "npm:pi-observational-memory@3.0.4",
        "npm:@narumitw/pi-goal@0.54.3",
        "npm:@ff-labs/pi-fff@0.10.5",
        "npm:@tmustier/pi-usage-extension@0.9.4",
    ],
}


def main() -> int:
    raw = sys.stdin.read()
    try:
        settings = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError as error:
        print(f"Pi settings are not valid JSON: {error}", file=sys.stderr)
        return 1
    if not isinstance(settings, dict):
        print("Pi settings must contain a JSON object", file=sys.stderr)
        return 1

    settings.update(MANAGED_SETTINGS)
    json.dump(settings, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
