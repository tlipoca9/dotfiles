{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Managed Pi settings checksum: {{ include "dot_pi/private_agent/modify_settings.json" | sha256sum }}
# Exact extension pins remain owned by ~/.pi/agent/settings.json.
die() {
  printf 'dotfiles: %s\n' "$*" >&2
  exit 1
}

setup_brew() {
  if ! command -v brew >/dev/null 2>&1 && [ -x /usr/libexec/path_helper ]; then
    eval "$(/usr/libexec/path_helper -s)"
  fi
  shellenv_file=${XDG_CACHE_HOME:-"$HOME/.cache"}/dotfiles/brew-shellenv
  if ! command -v brew >/dev/null 2>&1 && [ -r "$shellenv_file" ]; then
    . "$shellenv_file"
  fi
  command -v brew >/dev/null 2>&1 || die "Homebrew is unavailable; run 'chezmoi apply' again after Homebrew installation completes"
  eval "$(brew shellenv)"
}

setup_brew
command -v pi >/dev/null 2>&1 || die "Pi CLI is unavailable after package installation"
pi update --extensions
if ! pi_output=$(pi list 2>&1); then
  printf '%s\n' "$pi_output" >&2
  die "Pi extension listing failed"
fi
case "$pi_output" in
  *"Failed to load extension"*|*"Failed to start"*)
    printf '%s\n' "$pi_output" >&2
    die "Pi extension loading failed"
    ;;
esac
{{- else -}}
#!/bin/sh
exit 0
{{- end }}
