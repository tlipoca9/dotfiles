{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

die() {
  printf 'dotfiles: %s\n' "$*" >&2
  exit 1
}

if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install >/dev/null 2>&1 || true
  die "finish installing the Command Line Tools, then run '$HOME/.local/bin/chezmoi apply' again"
fi

if ! command -v brew >/dev/null 2>&1 && [ -x /usr/libexec/path_helper ]; then
  eval "$(/usr/libexec/path_helper -s)"
fi

if ! command -v brew >/dev/null 2>&1; then
  if ! ( : </dev/tty >/dev/tty 2>/dev/tty ); then
    die "Homebrew is missing; run '$HOME/.local/bin/chezmoi apply' again from an interactive terminal"
  fi
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    </dev/tty >/dev/tty 2>/dev/tty
  if [ -x /usr/libexec/path_helper ]; then
    eval "$(/usr/libexec/path_helper -s)"
  fi
fi

command -v brew >/dev/null 2>&1 || die "Homebrew installation finished but brew is not discoverable; open a new shell, then run '$HOME/.local/bin/chezmoi apply' again"
eval "$(brew shellenv)"

shellenv_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}/dotfiles
shellenv_file=$shellenv_dir/brew-shellenv
mkdir -p "$shellenv_dir"
umask 077
temporary=$(mktemp "$shellenv_dir/.brew-shellenv.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM
brew shellenv >"$temporary"
mv "$temporary" "$shellenv_file"
trap - EXIT HUP INT TERM
{{- else -}}
#!/bin/sh
exit 0
{{- end }}
