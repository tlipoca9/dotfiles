{{- if eq .chezmoi.os "darwin" -}}
{{- $installVersion := .darwin.dsh.install_version -}}
{{- if not (regexMatch "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" $installVersion) -}}
{{- fail "darwin.dsh.install_version must be a safe semantic version" -}}
{{- end -}}
#!/bin/sh
set -eu

# dsh declaration checksum: {{ include ".chezmoidata/darwin/dsh.toml" | sha256sum }}
{{ template "darwin-shell-helpers" . }}
if command -v dsh >/dev/null 2>&1; then
  printf 'dotfiles: dsh is already installed; keeping the installed version\n'
else
  setup_brew
  command -v node >/dev/null 2>&1 || die "Node.js is unavailable after package installation"
  command -v npm >/dev/null 2>&1 || die "npm is unavailable after Node.js installation"
  install_version={{ printf "'%s'" (replace "'" "'\"'\"'" $installVersion) }}
  printf 'dotfiles: installing dsh@%s\n' "$install_version"
  npm install --global --no-fund --no-audit "@deepseek-ai/dsh@$install_version"
  command -v dsh >/dev/null 2>&1 || die "dsh is unavailable after npm installation"
fi
{{- else -}}
#!/bin/sh
exit 0
{{- end }}
