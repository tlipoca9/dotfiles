{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Browser source declaration checksum: {{ include "dot_pi/private_agent/modify_settings.json.tmpl" | sha256sum }}
# Browser package checksum: {{ include "dot_pi/private_agent/extensions/browser/package.json" | sha256sum }}
# Browser dependency checksum: {{ include "dot_pi/private_agent/extensions/browser/package-lock.json" | sha256sum }}
{{ template "darwin-shell-helpers" . }}
setup_brew
command -v npm >/dev/null 2>&1 || die "npm is unavailable after package installation"

browser_dir="$HOME/.pi/agent/extensions/browser"
[ -f "$browser_dir/package-lock.json" ] || die "managed Pi browser extension is missing"

(
  cd "$browser_dir"
  npm ci --ignore-scripts --no-audit --no-fund
  ./node_modules/.bin/playwright-core install chromium
)
{{- else -}}
#!/bin/sh
exit 0
{{- end }}
