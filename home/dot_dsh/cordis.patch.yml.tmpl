# Inserted loader names must be strings: rc.6 does not evaluate !!js nodes in
# the name field of an inserted entry. Render the managed absolute path here.
- insert:
    - id: dsh-worktree
      name: {{ printf "%s/.dsh/worktree.mjs" .chezmoi.destDir | quote }}
      config:
        mode: host

# dsh's pi-ai adapter intentionally has no OAuth credential store. Reuse Pi's
# own auth command at request time; the bearer token never enters this repo or
# a dsh settings/credentials document.
- insert:
    - id: dsh-pi-auth-credentials
      name: {{ printf "%s/.dsh/pi-auth-credentials.mjs" .chezmoi.destDir | quote }}

# Match the Pi agent's current default selection.
- id: agent-default-model
  config:
    provider: openai-codex
    model: gpt-5.6-sol

# New web sessions use the coding preset that exposes Git-worktree delegation.
- id: agent-presets
  config:
    default: worktree

- id: llm-pi-ai
  config:
    providers:
      openai-codex:
        apiKeyEnv: OPENAI_CODEX_BEARER_TOKEN
        reasoning: high
